# Variáveis de ambiente — Cloud Run + Cloud SQL + Secret Manager
# Não commitar valores reais de senha/JWT neste arquivo.

SPRING_PROFILES_ACTIVE=gcp
GCP_PROJECT_ID=veiculos-pos-tech
GCP_CLOUDSQL_INSTANCE=veiculos-pos-tech:us-central1:veiculos-pos-tech-project
GCP_CLOUDSQL_DATABASE=veiculos
DB_USERNAME=veiculos_user

# JDBC explícita (opcional — se omitida, montada a partir de GCP_CLOUDSQL_*):
# DB_URL=jdbc:postgresql:///veiculos?cloudSqlInstance=veiculos-pos-tech:us-central1:veiculos-pos-tech-project&socketFactory=com.google.cloud.sql.postgres.SocketFactory&sslmode=disable

# Opção A — app carrega do Secret Manager:
# GCP_SECRET_MANAGER_ENABLED=true
# GCP_SECRET_DB_PASSWORD=veiculos-db-password
# GCP_SECRET_JWT=veiculos-jwt-secret

# Opção B — Cloud Run monta segredos como env (recomendado):
# DB_PASSWORD=<montado pelo Cloud Run --set-secrets>
# JWT_SECRET=<montado pelo Cloud Run --set-secrets>
GCP_SECRET_MANAGER_ENABLED=false

# Pub/Sub — desabilite na 1ª subida se o tópico ainda não existir:
GCP_PUBSUB_ENABLED=true
GCP_PUBSUB_TOPIC=veiculos-eventos

# Pub/Sub + Cloud Function:
# cd infra\gcp
# .\setup-pubsub.ps1 -ProjectId veiculos-pos-tech
# .\deploy-function.ps1 -ProjectId veiculos-pos-tech -Region us-central1

# Teste local com Cloud SQL Auth Proxy (opcional):
# cloud-sql-proxy veiculos-pos-tech:us-central1:veiculos-pos-tech-project
# DB_URL=jdbc:postgresql://127.0.0.1:5432/veiculos
# DB_PASSWORD=senha-local
# JWT_SECRET=segredo-local-com-pelo-menos-32-caracteres!!
# GCP_SECRET_MANAGER_ENABLED=false
# GCP_PUBSUB_ENABLED=false
