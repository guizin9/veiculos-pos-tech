# Variáveis de ambiente — copie para .env e ajuste (docker compose lê .env automaticamente)

# Banco de dados
DB_URL=jdbc:postgresql://localhost:5433/veiculos
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Servidor
SERVER_PORT=8083

# JWT (mínimo 32 caracteres)
JWT_SECRET=troque-este-segredo-para-um-valor-forte-com-32+chars
JWT_EXPIRACAO_MIN=120

# Reserva / pagamento
RESERVA_MINUTOS_EXPIRACAO=30
RESERVA_INTERVALO_VERIFICACAO_MS=60000

# AWS — desabilitado no dev local sem Docker; habilitado no docker-compose
AWS_ENABLED=false
AWS_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SQS_ENABLED=false
AWS_SQS_QUEUE_NAME=veiculos-eventos
AWS_SECRETS_ENABLED=false
AWS_SECRET_NAME=veiculos/app

# Perfil Spring (use "docker" com docker compose up)
# SPRING_PROFILES_ACTIVE=docker
